#!/usr/bin/env bash
set -euo pipefail

# Pin apps to Cinnamon favorites (used by the panel favorites applet).
# Runs in the user's desktop session (autostart), not during onboot.

if ! command -v gsettings >/dev/null 2>&1; then
    exit 0
fi

have_desktop() {
    local id="$1"
    [ -f "/usr/share/applications/$id" ] || [ -f "/usr/local/share/applications/$id" ]
}

choose_brave_desktop_id() {
    if have_desktop brave-browser.desktop; then
        printf '%s\n' brave-browser.desktop
        return 0
    fi
    if have_desktop com.brave.Browser.desktop; then
        printf '%s\n' com.brave.Browser.desktop
        return 0
    fi
    return 1
}

choose_wezterm_desktop_id() {
    if have_desktop org.wezfurlong.wezterm.desktop; then
        printf '%s\n' org.wezfurlong.wezterm.desktop
        return 0
    fi
    if have_desktop wezterm.desktop; then
        printf '%s\n' wezterm.desktop
        return 0
    fi
    return 1
}

# The base image ships kitty, NOT wezterm, so this is the terminal that actually
# exists on a live boot (config.sh even ships a kitty.conf). Prefer kitty over
# wezterm - see the terminal pick in choose_terminal_desktop_id below.
choose_kitty_desktop_id() {
    if have_desktop kitty.desktop; then
        printf '%s\n' kitty.desktop
        return 0
    fi
    if have_desktop org.kitty.kitty.desktop; then
        printf '%s\n' org.kitty.kitty.desktop
        return 0
    fi
    return 1
}

# Terminal to pin: kitty first (installed), then wezterm, then the generic
# terminals, so the panel entry is never empty just because wezterm is absent.
choose_terminal_desktop_id() {
    local id
    for fn in choose_kitty_desktop_id choose_wezterm_desktop_id; do
        id="$($fn 2>/dev/null || true)"
        [ -n "$id" ] && { printf '%s\n' "$id"; return 0; }
    done
    for id in org.gnome.Terminal.desktop xterm.desktop; do
        [ -f "/usr/share/applications/$id" ] && { printf '%s\n' "$id"; return 0; }
    done
    return 1
}

append_unique() {
    local item="$1"; shift
    local x
    for x in "$@"; do
        [ "$x" != "$item" ] || { printf '%s\n' "$@"; return 0; }
    done
    printf '%s\n' "$@" "$item"
}

# Parse `gsettings get` output for a string-array ("as") key into one item per
# line. `gsettings get` prints ['a.desktop', 'b.desktop'] on a SINGLE line, so
# the old parser (strip [], quotes and commas, then read newline-delimited)
# collapsed the whole existing list into one bogus token: the array became
# ['a.desktop b.desktop', ...] and every pre-existing favorite disappeared from
# the panel. Split on commas instead.
parse_gsettings_array() {
    local raw="$1"
    raw="${raw#[}"; raw="${raw%]}"
    raw="${raw//\'/}"
    local tok
    local IFS=','
    for tok in $raw; do
        tok="${tok#"${tok%%[![:space:]]*}"}"
        tok="${tok%"${tok##*[![:space:]]}"}"
        [ -n "$tok" ] && printf '%s\n' "$tok"
    done
}

want=()
term="$(choose_terminal_desktop_id 2>/dev/null || true)"
brave="$(choose_brave_desktop_id 2>/dev/null || true)"
[ -n "${term:-}" ] && want+=("$term")
[ -n "${brave:-}" ] && want+=("$brave")
[ "${#want[@]}" -gt 0 ] || exit 0

# Read current favorites, one per line.
cur_raw="$(gsettings get org.cinnamon favorite-apps 2>/dev/null || true)"

cur=()
while IFS= read -r tok; do
    [ -n "$tok" ] && cur+=("$tok")
done < <(parse_gsettings_array "$cur_raw")

# Self-heal a value corrupted by an earlier version of this script: it wrote
# space-joined multiples back as one quoted element. Any element containing a
# space cannot be a desktop-file id, so split those on spaces.
healed=()
for tok in "${cur[@]}"; do
    if [[ "$tok" == *" "* ]]; then
        for sub in $tok; do
            [ -n "$sub" ] && healed+=("$sub")
        done
    else
        healed+=("$tok")
    fi
done
[ "${#healed[@]}" -eq 0 ] || cur=("${healed[@]}")

for app in "${want[@]}"; do
    mapfile -t cur < <(append_unique "$app" "${cur[@]}")
done

# Build gsettings array literal.
out="["
for i in "${!cur[@]}"; do
    [ "$i" -eq 0 ] || out+=", "
    out+="'${cur[$i]}'"
done
out+="]"

gsettings set org.cinnamon favorite-apps "$out" 2>/dev/null || true

