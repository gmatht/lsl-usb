#!/bin/bash
# lsl-tui - terminal launcher for Linux Services for Linux - WSL emulator
#
# Formerly lsl-gui (renamed: it never was a GUI). Launches the CLI chooser
# (`lsl --choose`) in a terminal instead. For the graphical launcher, see
# lsl-gui. Run it as: bash /cdrom/bin/lsl-tui (FAT has no exec bit).
WSL_REPORT="${WSL_REPORT:-/tmp/wsl}"
LSL_SCRIPT_DIR="$(cd -- "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd -P)"
LSL_SCRIPT="$LSL_SCRIPT_DIR/lsl"
# shellcheck source=/dev/null
. "$LSL_SCRIPT_DIR/lsl-common.sh"

# Terminal to host the chooser. wezterm is the intended one but is NOT in the
# base image (kitty is; config.sh even ships a kitty.conf), so a hard wezterm
# dependency means the desktop icon dies with "wezterm: command not found".
# Fall back through the terminals that actually exist on a live boot.
_pick_term() {
    for t in wezterm kitty x-terminal-emulator gnome-terminal xterm; do
        command -v "$t" >/dev/null 2>&1 && { printf '%s\n' "$t"; return 0; }
    done
    return 1
}

_term="$(_pick_term)" || {
    echo "lsl-gui: no terminal emulator found (tried wezterm kitty x-terminal-emulator gnome-terminal xterm)" >&2
    exit 1
}

case "$_term" in
    wezterm) exec wezterm start -- sudo bash -c "bash $LSL_SCRIPT --choose --pause-on-quit; read" ;;
    kitty)   exec kitty -- sudo bash -c "bash $LSL_SCRIPT --choose --pause-on-quit; read" ;;
    gnome-terminal) exec gnome-terminal -- sudo bash -c "bash $LSL_SCRIPT --choose --pause-on-quit; read" ;;
    *)       exec "$_term" -e sudo bash -c "bash $LSL_SCRIPT --choose --pause-on-quit; read" ;;
esac
