#!/bin/bash
# lsl-ramclone-status - report dm-clone hydration progress.
#
# Reads /run/ramclone/status and dmsetup status to report:
#   - overall percent hydrated
#   - whether the USB is safe to eject
#   - current hydration rate (if available)
#
# Exit codes:
#   0  - hydration complete, USB safe to eject
#   1  - hydration in progress (percent printed to stdout)
#   2  - ramclone not active
#   3  - error querying status

set -uo pipefail

RAMCLONE_DIR="/run/ramclone"
[ -f "$RAMCLONE_DIR/status" ] || { echo "ramclone not active"; exit 2; }

# dm-clone STATUSTYPE_INFO line (after `dmsetup status` prepends start/length):
#   0 <len> clone <meta block size> <used>/<total meta blocks> <region size> <hydrated>/<total regions> <hydrating> ...
# The hydrated/total region pair is field 7 - NOT fields 4/5 (those are the
# metadata block size / block counts, both integers-or-slashes that used to be
# mis-read and made this always report 0%).
status_line=$(dmsetup status clone 2>/dev/null)
[ -n "$status_line" ] || { echo "error querying dm-clone status"; exit 3; }

set -- $status_line
[ "${3:-}" = "clone" ] || { echo "error parsing dm-clone status"; exit 3; }
hydtot="${7:-}"
case "$hydtot" in
    */*) hyd="${hydtot%%/*}"; total="${hydtot##*/}" ;;
    *) echo "error parsing dm-clone status"; exit 3 ;;
esac
case "$hyd" in ''|*[!0-9]*) echo "error parsing dm-clone status"; exit 3 ;; esac
case "$total" in ''|*[!0-9]*) echo "error parsing dm-clone status"; exit 3 ;; esac
[ "$total" -gt 0 ] 2>/dev/null || { echo "error parsing dm-clone status"; exit 3; }

pct=$(( hyd * 100 / total ))

if [ "$hyd" -eq "$total" ]; then
    echo "100"
    echo "Hydration complete — USB is safe to eject."
    exit 0
else
    echo "$pct"
    echo "Hydrating: $pct% ($hyd / $total regions) — do not remove USB yet."
    exit 1
fi
