#!/bin/bash
# lsl-gui - GUI launcher for Linux Services for Linux - WSL emulator
#
# The WinForms-style GUI is currently broken; this launches the CLI chooser
# (`lsl --choose`) in a terminal instead. See git history for the old GUI code.
WSL_REPORT="${WSL_REPORT:-/tmp/wsl}"
LSL_SCRIPT_DIR="$(cd -- "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd -P)"
LSL_SCRIPT="$LSL_SCRIPT_DIR/lsl"
# shellcheck source=/dev/null
. "$LSL_SCRIPT_DIR/lsl-common.sh"

wezterm start -- sudo bash -c "bash $LSL_SCRIPT --choose --pause-on-quit; read"
