#!/bin/bash
# Persist home: USB — flush overlay to home.sfs; HDD — btrfs sync.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
. "$SCRIPT_DIR/lsl-common.sh"

lsl_load_config

# Decide from the mode /home was ACTUALLY mounted with (recorded by
# lsl-mount-home.sh), not from a fresh data-dir resolve. On the first boot the
# data dir can start out non-persistent (hivex-tools missing -> /mnt/c not
# mounted), so /home is a tmpfs overlay; by the time firstboot finishes, /mnt/c
# is mounted and lsl_is_usb_mode flips to "hdd". Trusting that re-resolve made
# this script take the HDD branch, no-op the btrfs sync, and drop the whole
# first-boot home on reboot.
_ehm="$(lsl_effective_home_mode)"

# Boot-to-RAM "(no persistence)": /home is a tmpfs - nothing to persist.
if [ "$_ehm" = "ram" ] || [ "$(findmnt -n -o FSTYPE --target /home 2>/dev/null || true)" = "tmpfs" ]; then
    echo "uphome: /home is RAM (Boot to RAM, no persistence); nothing to persist."
    exit 0
fi

# Fallback tmpfs overlay (HDD data dir was not persistent when /home was
# mounted). It has the same layout as a real USB-mode overlay but is a transient
# accident, so say so loudly rather than silently "succeeding" with a no-op sync.
if [ "$_ehm" = "usb-fallback" ]; then
    echo "uphome: /home is a FALLBACK tmpfs overlay (HDD data dir was not persistent" >&2
    echo "        when /home was mounted); its contents WILL BE LOST on reboot." >&2
    echo "        Free space on the data dir / mount it, then reboot and rebuild" >&2
    echo "        the layer on a boot where /home mounts persistently." >&2
    exit 1
fi

if [ "$_ehm" = "usb" ] || { [ -z "$_ehm" ] && lsl_is_usb_mode; }; then
    echo "USB mode: flushing merged /home to the stick's per-distro home image…"
    exec "$SCRIPT_DIR/lsl-flush-home.sh"
fi

# f2fs upper: every write already went straight to the partition, so there is no
# image to flush and no btrfs to sync. Only the wifi record still needs writing.
# It MUST be handled before the HDD branch below, which would sync btrfs paths
# that do not exist on an f2fs boot and then report a misleading success.
if [ "$_ehm" = "f2fs" ]; then
    echo "f2fs mode: /home is already persistent on ${LSL_PERSIST_MNT:-/persist}; syncing…"
    if [ -x "$SCRIPT_DIR/persist-wifi.sh" ]; then
        "$SCRIPT_DIR/persist-wifi.sh" || true
    fi
    sync
    echo "f2fs home sync complete (changes were written live, not packed)."
    exit 0
fi

echo "HDD mode: syncing btrfs…"
btrfs filesystem sync /home 2>/dev/null || true
if mountpoint -q /mnt/lsl-cache 2>/dev/null; then
    btrfs filesystem sync /mnt/lsl-cache 2>/dev/null || true
fi
if [ -x "$SCRIPT_DIR/persist-wifi.sh" ]; then
    "$SCRIPT_DIR/persist-wifi.sh" || true
fi
sync
echo "home/cache btrfs sync complete."
