[Unit]
Description=lsl-usb first-boot setup (one-shot, per-install)
# Runs after onboot.service (which connects wifi) and waits for the network
# before installing packages. Wi-fi staging is also kept as a fallback.
After=network-online.target NetworkManager.service onboot.service
Wants=network-online.target
# Cap any rapid crash loop (the script already rate-limits its own retries via
# RestartSec + MAX_ATTEMPTS, this is a belt-and-braces backstop).
StartLimitBurst=10
StartLimitIntervalSec=600

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/lsl-firstboot.sh
Restart=on-failure
RestartSec=300
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
