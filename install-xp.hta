<!-- NO <!DOCTYPE>: a strict doctype forces the latest IE standards (edge)
     mode, which does not lay out HTA's native Win32 controls until a repaint
     (hover). Quirks/IE mode lays them out correctly. We do NOT host ISOs -
     the default URL points at the distro's official mirror (same one
     install.ps1 uses). -->
<html>
<head>
<meta http-equiv="x-ua-compatible" content="IE=9">
<hta:application id="lsl" applicationname="lsl-usb (legacy / WinXP+)"
  version="1.0" border="dialog" caption="yes" maximizebutton="no" minimizebutton="yes" singleinstance="yes" windowstate="normal" scroll="auto" />
<title>lsl-usb installer (legacy / WinXP+)</title>
<style>
  body { font: 11pt Tahoma, Verdana, sans-serif; background:#f4f4f4; margin:8px; }
  h2 { font-size:13pt; margin:0 0 4px 0; }
  #reco { background:#e8f0ff; border:1px solid #9bb; padding:6px; margin:6px 0; white-space:pre; }
  fieldset { margin:6px 0; padding:6px; }
  #log { width:100%; height:120px; font:9pt Consolas, monospace; }
  #hwSummary { margin:2px 0 4px 0; font:9pt Consolas, monospace; white-space:pre; }
  #hwTableWrap { max-height:240px; overflow:auto; border:1px solid #9bb; background:#fff; }
  table.hwtable { border-collapse:collapse; width:100%; font:9pt Consolas, monospace; }
  table.hwtable th, table.hwtable td { border:1px solid #ccd; padding:2px 5px; text-align:left; white-space:nowrap; }
  table.hwtable th { background:#dde7ff; cursor:pointer; user-select:none; }
  table.hwtable th:hover { background:#c7d6ff; }
  table.hwtable th.asc::after { content:" \25B2"; }
  table.hwtable th.desc::after { content:" \25BC"; }
  table.hwtable tr:nth-child(even) td { background:#f7f9ff; }
  table.hwtable td.lk { text-align:center; }
  table.hwtable td.lk span.lkicon { display:inline-block; line-height:0; cursor:pointer; }
  table.hwtable td.lk svg { vertical-align:middle; }
  button { font:10pt Tahoma; padding:3px 8px; }
  .row { margin:3px 0; }
  label { display:block; }
</style>
</head>
<body onload="Window_OnLoad()">
<h2>lsl-usb installer &mdash; legacy mode</h2>
<div id="reco">Probing this PC...</div>

<fieldset><legend>Linux hardware compatibility (linux-hardware.org LKDDb)</legend>
  <div class="row">
    <button onclick="ScanHardware()">Scan this PC's hardware</button>
  </div>
  <div class="row" id="hwSummary">&nbsp;</div>
  <div class="row" id="hwTableWrap">
    <table id="devTable" class="hwtable">
      <thead>
        <tr>
          <th onclick="sortTable(0)">Category</th>
          <th onclick="sortTable(1)">Support</th>
          <th onclick="sortTable(2)">Device</th>
          <th onclick="sortTable(3)">ID</th>
          <th onclick="sortTable(4)">Link</th>
        </tr>
      </thead>
      <tbody id="devBody">
        <tr><td colspan="5"><i>Click &quot;Scan this PC's hardware&quot; to list devices.</i></td></tr>
      </tbody>
    </table>
  </div>
</fieldset>

<fieldset><legend>ISO image</legend>
  <div class="row">
    <button id="bBrowse" onclick="BrowseISO()">Browse for ISO...</button>
    <button id="bScan" onclick="ScanISOs()">Re-scan common folders</button>
  </div>
  <div id="isoList" class="row"></div>
</fieldset>

<fieldset><legend>Download (if you don't have an ISO)</legend>
  <div class="row">Distro:
    <select id="distro" onchange="SetDistroURL()">
      <option value="">-- choose a distro --</option>
      <option value="https://antixlinux.com/download/">antiX 26 (i386 / 32-bit)</option>
      <option value="https://cdimage.ubuntu.com/lubuntu/releases/24.04/release/">Lubuntu 24.04 (64-bit, light)</option>
      <option value="https://cdimage.ubuntu.com/xubuntu/releases/24.04/release/">Xubuntu 24.04 (64-bit, light-ish)</option>
      <option value="https://mirrors.kernel.org/linuxmint/stable/22.3/linuxmint-22.3-cinnamon-64bit.iso">Mint Cinnamon 22.x (64-bit)</option>
      <option value="https://zorin.com/os/download/">Zorin OS (64-bit)</option>
      <option value="https://cdimage.debian.org/cdimage/release/13.6.0-live/amd64/iso-cd/debian-live-13.6.0-amd64-xfce.iso">Debian 13.6 live XFCE (64-bit)</option>
    </select>
  </div>
  <div class="row">URL: <input id="url" size="72"></div>
  <div class="row">
    <button id="bDl" onclick="Download()">Download via BITS (http only)</button>
    <button id="bBrowser" onclick="DownloadInBrowser()">Open in browser &amp; watch Downloads</button>
  </div>
  <div class="row" id="dlStatus">&nbsp;</div>
</fieldset>

<fieldset><legend>Write to USB (Rufus)</legend>
  <div class="row">
    Rufus: <input id="rufus" size="55">
    <button onclick="BrowseRufus()">Browse...</button>
    <button onclick="DownloadRufus()">Download Rufus</button>
    <span id="rufusHint">(auto-detected if on PATH)</span>
  </div>
  <div class="row">
    <button id="bWrite" onclick="LaunchRufus()">Launch Rufus with selected ISO</button>
    <button onclick="BootFromUsb()">Boot from USB (after writing)</button>
  </div>
  <div class="row">
    <label><input type='checkbox' id='chkReclaim'> Reclaim Windows pagefile.sys / WSL2 swapfile.vhdx as compressed swap (renames them after a clean shutdown; needs LSL_RECLAIM_WIN_SWAP)</label>
  </div>
</fieldset>

<div class="row"><textarea id="log" readonly></textarea></div>

<script language="VBScript">
Option Explicit
Dim oWSH, oFSO, is64, ramKB, recoText, watchTimer, watchBase, watchName
Dim rufusWatchTimer, rufusWatchBase, rufusWatchDest
Dim reclaimWatchTimer, reclaimAttempts

Sub Log(s)
  Call InitEnv()
  document.getElementById("log").value = document.getElementById("log").value & s & vbCrLf
End Sub

Function Env(n)
  Call InitEnv()
  Env = oWSH.ExpandEnvironmentStrings("%" & n & "%")
End Function

Function BundleDir()
  Call InitEnv()
  Dim p
  p = window.location.pathname
  p = Replace(p, "/", "\")
  If Left(p, 1) = "\" Then p = Mid(p, 2)
  BundleDir = oFSO.GetParentFolderName(p)
End Function

Sub InitEnv()
  If TypeName(oWSH) = "Empty" Or TypeName(oWSH) = "Nothing" Then Set oWSH = CreateObject("WScript.Shell")
  If TypeName(oFSO) = "Empty" Or TypeName(oFSO) = "Nothing" Then Set oFSO = CreateObject("Scripting.FileSystemObject")
End Sub

Function RX(pat, src, grp)
  Call InitEnv()
  Dim re, m
  Set re = New RegExp
  re.Pattern = pat
  re.IgnoreCase = True
  re.Global = False
  On Error Resume Next
  Set m = re.Execute(src)
  If Err.Number = 0 And m.Count > 0 And m(0).SubMatches.Count >= grp Then
    RX = m(0).SubMatches(grp - 1)
  Else
    RX = ""
  End If
  Err.Clear
  On Error GoTo 0
End Function

Function RXAll(pat, src)
  Call InitEnv()
  Dim re, m, c, out
  Set re = New RegExp
  re.Pattern = pat
  re.IgnoreCase = True
  re.Global = True
  On Error Resume Next
  Set m = re.Execute(src)
  out = ""
  If Err.Number = 0 Then
    For Each c In m
      If out = "" Then out = c.SubMatches(0) Else out = out & "|" & c.SubMatches(0)
    Next
  End If
  Err.Clear
  On Error GoTo 0
  RXAll = out
End Function

Function HTMLEscape(s)
  Call InitEnv()
  HTMLEscape = "" & s
  HTMLEscape = Replace(HTMLEscape, "&", "&amp;")
  HTMLEscape = Replace(HTMLEscape, "<", "&lt;")
  HTMLEscape = Replace(HTMLEscape, ">", "&gt;")
  HTMLEscape = Replace(HTMLEscape, """", "&quot;")
End Function

Function GlobeIcon()
  Call InitEnv()
  Dim svg
  svg = "<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 16 16'>" & _
    "<circle cx='8' cy='8' r='6.5' fill='#e8f4ff' stroke='#2a6fbb' stroke-width='1'/>" & _
    "<path d='M1.5 8h13 M8 1.5c3 3 3 10 0 13 M8 1.5c-3 3-3 10 0 13' fill='none' stroke='#2a6fbb' stroke-width='0.8'/></svg>"
  svg = Replace(Replace(Replace(Replace(svg, " ", "%20"), "<", "%3C"), ">", "%3E"), "#", "%23")
  GlobeIcon = "<span class='lkicon' title='Look up on linux-hardware.org'><img src='data:image/svg+xml," & svg & "' alt='web' width='14' height='14'></span>"
End Function

Sub AddCell(tr, key, html)
  Dim td
  Set td = tr.insertCell(-1)
  td.setAttribute "data-sort", key
  td.innerHTML = html
End Sub

Sub ClearBody()
  Dim b
  Set b = document.getElementById("devBody")
  Do While b.rows.length > 0
    b.deleteRow 0
  Loop
End Sub

Sub Window_OnLoad()
  Call InitEnv()
  Set oWSH = CreateObject("WScript.Shell")
  Set oFSO = CreateObject("Scripting.FileSystemObject")
  Call Recommend()
  Call AutoRufus()
  If is64 And ramKB >= 2097152 Then
    document.getElementById("url").value = "https://mirrors.kernel.org/linuxmint/stable/22.3/linuxmint-22.3-cinnamon-64bit.iso"
  ElseIf is64 And ramKB >= 1048576 Then
    document.getElementById("url").value = "https://cdimage.ubuntu.com/lubuntu/releases/24.04/release/"
  Else
    document.getElementById("url").value = "https://antixlinux.com/download/"
  End If
  document.getElementById("distro").value = document.getElementById("url").value
  Call ScanISOs()
  Log("Legacy mode ready. CPU/RAM gate: " & recoText & ".")
  document.body.style.visibility = "hidden"
  window.setTimeout "document.body.style.visibility='visible'", 0
End Sub

Sub Recommend()
  Call InitEnv()
  Dim arch, w6432, exec, out, line
  arch = Env("PROCESSOR_ARCHITECTURE")
  w6432 = Env("PROCESSOR_ARCHITEW6432")
  is64 = (arch = "AMD64" Or arch = "IA64" Or w6432 <> "")
  ramKB = 0
  On Error Resume Next
  Set exec = oWSH.Exec("wmic os get TotalVisibleMemorySize")
  If Err.Number = 0 Then
    out = exec.StdOut.ReadAll
    For Each line In Split(out, vbCrLf)
      If IsNumeric(Trim(line)) Then ramKB = CLng(Trim(line))
    Next
  End If
  On Error GoTo 0
  If is64 And ramKB >= 2097152 Then
    recoText = "Mint Cinnamon 22.3 (64-bit, >=2GB RAM)"
  ElseIf is64 And ramKB >= 1048576 Then
    recoText = "Lubuntu 24.04 (64-bit, 1-2GB RAM) - Xubuntu 24.04 also runs on 1GB but is heavier"
  Else
    recoText = "antiX 26 (i386 / antix26_386)"
  End If
  Dim ramStr
  If ramKB > 0 Then ramStr = CStr(ramKB) & " KB" Else ramStr = "unknown (wmic unavailable)"
  document.getElementById("reco").innerText = _
    "Recommended for this PC: " & recoText & vbCrLf & _
    "  arch=" & arch & "  w6432=" & w6432 & "  RAM=" & ramStr & vbCrLf & _
    "  (confirm/change your choice; pick any ISO below, or a distro in the Download section)"
End Sub

Sub SetDistroURL()
  Call InitEnv()
  Dim v
  v = document.getElementById("distro").value
  If v <> "" Then document.getElementById("url").value = v
End Sub

Function DriverTable()
  Call InitEnv()
  DriverTable = Array( _
    "0BDA:8812|Realtek RTL8812AU|rtl8812au-dkms", _
    "0BDA:881A|Realtek RTL8814AU|rtl8814au", _
    "0BDA:8179|Realtek RTL8188EU|rtl8188eu", _
    "0BDA:B720|Realtek RTL8723BU|rtl8723bu", _
    "14E4:4365|Broadcom BCM43142|broadcom-sta-dkms", _
    "14E4:43A0|Broadcom BCM4360|broadcom-sta-dkms", _
    "14E4:43B1|Broadcom BCM4352|broadcom-sta-dkms", _
    "14E4:4727|Broadcom BCM4313|broadcom-sta-dkms")
End Function

Function RatableClasses()
  Call InitEnv()
  RatableClasses = Array("Net", "Display", "MEDIA", "Bluetooth", _
    "Biometric", "Image", "SmartCardReader", "HDC", "SCSIAdapter", _
    "Modem", "PCMCIA", "Camera", "61883")
End Function

Function ParsePnp(pnp, ByRef kind, ByRef ven, ByRef dev)
  Call InitEnv()
  Dim re, m
  Set re = New RegExp
  re.IgnoreCase = True
  re.Pattern = "PCI\\VEN_([0-9A-Fa-f]{4})&DEV_([0-9A-Fa-f]{4})"
  Set m = re.Execute(pnp)
  If m.Count > 0 Then
    kind = "PCI" : ven = UCase(m(0).SubMatches(0)) : dev = UCase(m(0).SubMatches(1))
    ParsePnp = True : Exit Function
  End If
  re.Pattern = "USB\\VID_([0-9A-Fa-f]{4})&PID_([0-9A-Fa-f]{4})"
  Set m = re.Execute(pnp)
  If m.Count > 0 Then
    kind = "USB" : ven = UCase(m(0).SubMatches(0)) : dev = UCase(m(0).SubMatches(1))
    ParsePnp = True : Exit Function
  End If
  ParsePnp = False
End Function

Function ReadCache(kind, ven, dev)
  Call InitEnv()
  Dim f, html
  html = ""
  f = BundleDir() & "\lsl-hw-cache\lsl-lhw-" & LCase(kind) & "-" _
    & UCase(ven) & "-" & UCase(dev) & ".html"
  On Error Resume Next
  If oFSO.FileExists(f) Then html = oFSO.OpenTextFile(f, 1).ReadAll
  On Error GoTo 0
  ReadCache = html
End Function

Function RateDevice(kind, ven, dev, name)
  Call InitEnv()
  Dim id, html, ksup, src, third, t, parts, mm, mmm, inKernel, bridge
  id = ven & ":" & dev
  For Each t In DriverTable()
    parts = Split(t, "|")
    If parts(0) = id Then
      RateDevice = "C|needs out-of-tree driver (" & parts(2) & ") - staged to <USB>:\drivers\"
      Exit Function
    End If
  Next
  html = ReadCache(kind, ven, dev)
  If html = "" Then
    RateDevice = "U|no data (linux-hardware.org cache miss / unreachable)"
    Exit Function
  End If
  name = RX("<h2 class='top'>Device '([^']+)'", html, 1)
  ksup = RX("supported by kernel versions <a[^>]*>([^<]+)</a>", html, 1)
  src  = RX("<td>([0-9.]+)&nbsp;-&nbsp;([0-9.]+)</td>[ \t\r\n]*<td>([^<]+)</td>", html, 3)
  third = RXAll("<li><a href=""https://github.com/([^""]+)"">", html)
  If ksup = "" Then
    If third <> "" Then
      RateDevice = "U|no LKDDb entry - out-of-tree options: " & Replace(third, "|", ", ")
    Else
      RateDevice = "U|no LKDDb entry"
    End If
    Exit Function
  End If
  mm = 0 : mmm = 0
  If RX("^([0-9]+)\.([0-9]+)", ksup, 1) <> "" Then
    mm = CInt(RX("^([0-9]+)\.([0-9]+)", ksup, 1))
    mmm = CInt(RX("^([0-9]+)\.([0-9]+)", ksup, 2))
  End If
  inKernel = (mm < 6) Or (mm = 6 And mmm <= 8)
  bridge = (src <> "" And (InStr(1, src, "bcma") > 0 Or InStr(1, src, "bluetty") > 0 _
    Or InStr(1, src, "usb/class") > 0 Or InStr(1, src, "host_pci") > 0 Or InStr(1, src, "pci-bridge") > 0))
  If inKernel And Not bridge Then
    RateDevice = "A|in-kernel since " & ksup & " (" & src & ") - no action needed"
  ElseIf inKernel And bridge Then
    RateDevice = "D|LKDDb entry is only " & src & " - no real driver for this function"
  Else
    If third <> "" Then
      RateDevice = "C|needs kernel " & ksup & "+ (ISO has 6.8) - out-of-tree: " & Replace(third, "|", ", ")
    Else
      RateDevice = "C|needs kernel " & ksup & "+ (ISO has 6.8)"
    End If
  End If
End Function

Sub OnIconClick()
  Dim el, url
  On Error Resume Next
  Set el = window.event.srcElement
  Do While Not (el Is Nothing)
    url = el.getAttribute("data-url")
    If Not IsNull(url) And url <> "" Then Exit Do
    Set el = el.parentNode
  Loop
  If Not (el Is Nothing) And Not IsNull(url) And url <> "" Then
    Log("Opening browser: " & url & "  (browser does TLS 1.2)")
    oWSH.Run url
  End If
End Sub

Sub ScanHardware()
  Call InitEnv()
  Dim wmi, col, d, pnp, kind, ven, dev, classes, cls, keep, id, nm
  Dim r, parts, cA, cC, cD, cU, lurl, tr, td, tb
  cA = 0 : cC = 0 : cD = 0 : cU = 0
  On Error Resume Next
  Set wmi = GetObject("winmgmts:\\.\root\cimv2")
  Set col = wmi.ExecQuery("SELECT Name,PNPDeviceID,PNPClass FROM Win32_PnPEntity")
  On Error GoTo 0
  If wmi Is Nothing Or col Is Nothing Then
    document.getElementById("hwSummary").innerText = "WMI unavailable - cannot read PnP hardware."
    Call ClearBody()
    Exit Sub
  End If
  Set tb = document.getElementById("devBody")
  Call ClearBody()
  For Each d In col
    pnp = "" & d.PNPDeviceID
    If ParsePnp(pnp, kind, ven, dev) Then
      cls = "" & d.PNPClass
      keep = False
      For Each classes In RatableClasses()
        If cls = classes Then keep = True
      Next
      If keep Then
        nm = "" & d.Name
        id = ven & ":" & dev
        r = RateDevice(kind, ven, dev, nm)
        parts = Split(r, "|", 2)
        If parts(0) = "A" Then cA = cA + 1
        If parts(0) = "C" Then cC = cC + 1
        If parts(0) = "D" Then cD = cD + 1
        If parts(0) = "U" Then cU = cU + 1
        lurl = "https://linux-hardware.org/?id=" & LCase(kind) & ":" & LCase(ven) & "-" & LCase(dev)
        Set tr = tb.insertRow(-1)
        Call AddCell(tr, LCase(cls), HTMLEscape(cls))
        Call AddCell(tr, parts(0), parts(0))
        Call AddCell(tr, LCase(nm), HTMLEscape(nm))
        Call AddCell(tr, id, id)
        Set td = tr.insertCell(-1)
        td.className = "lk"
        td.setAttribute "data-sort", lurl
        td.setAttribute "data-url", lurl
        td.innerHTML = GlobeIcon()
        td.onclick = GetRef("OnIconClick")
      End If
    End If
  Next
  If tb.rows.length = 0 Then
    Set tr = tb.insertRow(-1)
    Set td = tr.insertCell(-1)
    td.colSpan = 5
    td.innerHTML = "<i>No ratable devices found.</i>"
  End If
  document.getElementById("hwSummary").innerText = _
    "Summary: A=" & cA & " (in-kernel)  C=" & cC & " (out-of-tree)  D=" & cD & " (no driver)  U=" & cU & " (unknown)"
  Log("Hardware scan done. A=" & cA & " C=" & cC & " D=" & cD & " U=" & cU & ".")
End Sub

Sub ScanISOs()
  Call InitEnv()
  Dim dirs(5), i, dd, f, html, any, recUrl, recName, p, chk
  dirs(0) = oWSH.SpecialFolders("Desktop")
  dirs(1) = oWSH.SpecialFolders("MyDocuments") & "\Downloads"
  dirs(2) = oWSH.SpecialFolders("MyDocuments")
  dirs(3) = Env("USERPROFILE") & "\Downloads"
  dirs(4) = Env("SystemDrive") & "\"
  dirs(5) = Env("USERPROFILE")
  ' Auto-select the recommended ISO when it already exists locally.
  recUrl = document.getElementById("url").value
  recName = ""
  If recUrl <> "" Then
    p = InStrRev(recUrl, "/")
    If p > 0 Then recName = Mid(recUrl, p + 1)
  End If
  html = ""
  any = False
  For i = 0 To UBound(dirs)
    dd = dirs(i)
    If oFSO.FolderExists(dd) Then
      For Each f In oFSO.GetFolder(dd).Files
        If LCase(oFSO.GetExtensionName(f.Name)) = "iso" Then
          any = True
          chk = ""
          If LCase(f.Name) = LCase(recName) Then chk = " checked"
          html = html & "<label><input type='radio' name='iso' value='" _
            & Replace(f.Path, "'", "") & "'" & chk & ">" & f.Path & "</label><br>"
        End If
      Next
    End If
  Next
  If Not any Then html = "<i>No .iso found in Desktop / My Documents / Downloads. Browse or download one.</i>"
  document.getElementById("isoList").innerHTML = html
End Sub

Function SelectedISO()
  Call InitEnv()
  Dim el, els
  Set els = document.getElementsByTagName("input")
  For Each el In els
    If el.Name = "iso" And el.Checked Then SelectedISO = el.Value : Exit Function
  Next
  SelectedISO = ""
End Function

Sub BrowseISO()
  Call InitEnv()
  Dim sa, f
  Set sa = CreateObject("Shell.Application")
  Set f = sa.BrowseForFolder(0, "Select an ISO image", 0, 0)
  If Not f Is Nothing Then
    document.getElementById("isoList").innerHTML = _
      "<label><input type='radio' name='iso' value='" & f.Self.Path & "' checked>" _
      & f.Self.Path & "</label><br>"
  End If
End Sub

Sub Download()
  Call InitEnv()
  Dim url, dest, cmd, rc, q
  url = document.getElementById("url").value
  dest = oWSH.SpecialFolders("MyDocuments") & "\Downloads\" & oFSO.GetFileName(url)
  If LCase(Left(url, 8)) = "https://" Then
    Log("BITS on XP caps at TLS 1.0; use Open in browser & watch Downloads for https URLs.")
    Exit Sub
  End If
  q = Chr(34)
  cmd = "bitsadmin /transfer lsl /download /priority normal " & q & url & q & " " & q & dest & q
  Log("BITS: " & cmd)
  rc = oWSH.Run(cmd, 1, True)
  If rc = 0 And oFSO.FileExists(dest) Then
    document.getElementById("isoList").innerHTML = _
      "<label><input type='radio' name='iso' value='" & dest & "' checked>" & dest & "</label><br>"
    Log("Downloaded to " & dest)
  Else
    Log("BITS failed (rc=" & rc & "). Try the browser button instead.")
  End If
End Sub

Sub DownloadInBrowser()
  Call InitEnv()
  Dim url
  url = document.getElementById("url").value
  Log("Opening browser: " & url & "  (browser handles TLS 1.2; we watch Downloads)")
  oWSH.Run url
  watchBase = Array( _
    oWSH.SpecialFolders("MyDocuments") & "\Downloads", _
    Env("USERPROFILE") & "\Downloads", _
    oWSH.SpecialFolders("Desktop"), _
    oWSH.SpecialFolders("MyDocuments"))
  watchName = ""
  watchTimer = window.setInterval("WatchDownloads", 2000)
End Sub

Sub WatchDownloads()
  Call InitEnv()
  Dim i, dd, f, newest, ntime
  On Error Resume Next
  newest = "" : ntime = 0
  For i = 0 To UBound(watchBase)
    dd = watchBase(i)
    If oFSO.FolderExists(dd) Then
      For Each f In oFSO.GetFolder(dd).Files
        If LCase(oFSO.GetExtensionName(f.Name)) = "iso" Or _
           LCase(oFSO.GetExtensionName(f.Name)) = "part" Then
          If f.DateLastModified > ntime Then ntime = f.DateLastModified : newest = f.Path
        End If
      Next
    End If
  Next
  On Error GoTo 0
  If newest <> "" Then
    document.getElementById("dlStatus").innerText = "Watching: " & newest
    If LCase(oFSO.GetExtensionName(newest)) = "iso" Then
      window.clearInterval watchTimer
      document.getElementById("isoList").innerHTML = _
        "<label><input type='radio' name='iso' value='" & newest & "' checked>" & newest & "</label><br>"
      document.getElementById("dlStatus").innerText = "Detected: " & newest
      Log("Download detected in Downloads: " & newest)
    End If
  End If
End Sub

Sub AutoRufus()
  Call InitEnv()
  Dim p, exec
  On Error Resume Next
  p = oWSH.ExpandEnvironmentStrings("%SystemDrive%") & "\rufus.exe"
  If Not oFSO.FileExists(p) Then
    Set exec = oWSH.Exec("cmd /c where rufus.exe 2>nul")
    p = exec.StdOut.ReadLine
    If Err.Number <> 0 Or p = "" Then p = ""
    Err.Clear
  End If
  On Error GoTo 0
  If p <> "" Then document.getElementById("rufus").value = p
End Sub

Sub BrowseRufus()
  Call InitEnv()
  Dim sa, f
  Set sa = CreateObject("Shell.Application")
  Set f = sa.BrowseForFolder(0, "Select rufus.exe", 0, 0)
  If Not f Is Nothing Then document.getElementById("rufus").value = f.Self.Path
End Sub

Sub DownloadRufus()
  Call InitEnv()
  Log("Opening Rufus download page in your browser (https, not BITS-capable on XP): https://rufus.akeo.ie/")
  oWSH.Run "https://rufus.akeo.ie/"
End Sub

Function ReplaceEnvLine(content, key, val)
  Dim lines, i, out, done, ln
  lines = Split(content, vbCrLf)
  out = ""
  done = False
  For i = 0 To UBound(lines)
    ln = lines(i)
    If Left(ln, Len(key & "=")) = (key & "=") Or Left(ln, Len("# " & key & "=")) = ("# " & key & "=") Then
      out = out & key & "=" & val & vbCrLf
      done = True
    Else
      out = out & ln & vbCrLf
    End If
  Next
  If Not done Then out = out & key & "=" & val & vbCrLf
  ReplaceEnvLine = out
End Function

Sub WatchReclaim()
  Call InitEnv()
  Dim d, root, envPath, ts, content, found
  On Error Resume Next
  found = False
  For Each d In oFSO.Drives
    If d.IsReady Then
      root = d.DriveLetter & ":\"
      envPath = root & "lsl-usb.env"
      If oFSO.FileExists(envPath) Then
        content = oFSO.OpenTextFile(envPath, 1).ReadAll
        content = ReplaceEnvLine(content, "LSL_RECLAIM_WIN_SWAP", "1")
        Set ts = oFSO.OpenTextFile(envPath, 2, True)
        ts.Write content
        ts.Close
        Log("Set LSL_RECLAIM_WIN_SWAP=1 in " & envPath)
        found = True
        Exit For
      End If
    End If
  Next
  On Error GoTo 0
  If found Then
    window.clearInterval reclaimWatchTimer
    Log("Reclaim option applied. (Renames pagefile.sys / WSL2 swapfile as compressed swap on a clean shutdown.)")
  Else
    reclaimAttempts = reclaimAttempts + 1
    If reclaimAttempts > 40 Then
      window.clearInterval reclaimWatchTimer
      Log("Could not find the LSL USB volume with lsl-usb.env within ~2 min; set LSL_RECLAIM_WIN_SWAP=1 manually.")
    End If
  End If
End Sub

Sub LaunchRufus()
  Call InitEnv()
  Dim iso, ru, cmd, q
  iso = SelectedISO()
  If iso = "" Then Log("Pick or download an ISO first.") : Exit Sub
  ru = document.getElementById("rufus").value
  If Not oFSO.FileExists(ru) Then Log("Rufus not found: " & ru) : Exit Sub
  q = Chr(34)
  cmd = q & ru & q & " -i " & q & iso & q
  Log("Launching Rufus: " & cmd)
  oWSH.Run cmd, 1, False
  If document.getElementById("chkReclaim").checked Then
    reclaimAttempts = 0
    reclaimWatchTimer = window.setInterval("WatchReclaim", 3000)
    Log("Reclaim option checked: will set LSL_RECLAIM_WIN_SWAP=1 on the LSL USB once it appears.")
  End If
End Sub

Function BootMenuKey()
  Call InitEnv()
  Dim wmi, col, bb, manu, prod, m, key
  key = ""
  manu = ""
  prod = ""
  On Error Resume Next
  Set wmi = GetObject("winmgmts:\\.\root\cimv2")
  Set col = wmi.ExecQuery("SELECT Manufacturer,Product FROM Win32_BaseBoard")
  For Each bb In col
    manu = "" & bb.Manufacturer
    prod = "" & bb.Product
    Exit For
  Next
  If manu = "" Then
    Set col = wmi.ExecQuery("SELECT Manufacturer FROM Win32_ComputerSystem")
    For Each bb In col
      manu = "" & bb.Manufacturer
      Exit For
    Next
  End If
  On Error GoTo 0
  m = LCase(manu & " " & prod)
  If InStr(m, "dell") > 0 Then
    key = "F12"
  ElseIf InStr(m, "hewlett-packard") > 0 Or Left(m, 2) = "hp" Then
    key = "F9"
  ElseIf InStr(m, "lenovo") > 0 Then
    key = "F12"
  ElseIf InStr(m, "asus") > 0 Then
    key = "F8"
  ElseIf InStr(m, "msi") > 0 Or InStr(m, "micro-star") > 0 Then
    key = "F11"
  ElseIf InStr(m, "gigabyte") > 0 Then
    key = "F12"
  ElseIf InStr(m, "acer") > 0 Then
    key = "F12"
  ElseIf InStr(m, "toshiba") > 0 Then
    key = "F12"
  ElseIf InStr(m, "samsung") > 0 Then
    key = "F2"
  ElseIf InStr(m, "sony") > 0 Then
    key = "F11"
  ElseIf InStr(m, "intel") > 0 Then
    key = "F10"
  ElseIf InStr(m, "asrock") > 0 Then
    key = "F11"
  ElseIf InStr(m, "biostar") > 0 Then
    key = "F9"
  ElseIf InStr(m, "fujitsu") > 0 Then
    key = "F12"
  ElseIf InStr(m, "gateway") > 0 Then
    key = "F12"
  ElseIf InStr(m, "medion") > 0 Then
    key = "F11"
  ElseIf InStr(m, "razer") > 0 Then
    key = "F12"
  ElseIf InStr(m, "framework") > 0 Then
    key = "F12"
  ElseIf InStr(m, "system76") > 0 Then
    key = "F7"
  ElseIf InStr(m, "microsoft") > 0 And InStr(m, "surface") > 0 Then
    key = "F12"
  End If
  BootMenuKey = key
End Function

Sub BootFromUsb()
  Call InitEnv()
  Dim sh, sc, lnk, fw, args, rc, desc, hint, k
  Set sh = CreateObject("WScript.Shell")
  fw = ""
  If OSVersion() >= 6.2 Then fw = "/fw "   ' UEFI one-time boot menu (Win8+)
  args = "/r " & fw & "/t 0"
  If fw <> "" Then
    desc = "Reboots into the firmware boot menu - use the arrow keys to select the lsl-usb USB and press Enter."
    hint = "Windows will reboot into the firmware boot menu." & vbCrLf & _
      "Use the arrow keys to select the lsl-usb USB and press Enter."
  Else
    k = BootMenuKey()
    If k <> "" Then
      desc = "Reboots - press " & k & " during POST to open the boot menu, then select the lsl-usb USB."
      hint = "Press " & k & " during POST to open the boot menu, then select the lsl-usb USB."
    Else
      desc = "Reboots - press F12/Del/Esc during POST to open the boot menu, then select the lsl-usb USB."
      hint = "Press F12/Del/Esc during POST to open the boot menu, then select the lsl-usb USB."
    End If
  End If
  ' Desktop shortcut
  lnk = sh.SpecialFolders("Desktop") & "\LSL - Reboot to Select USB.lnk"
  Set sc = sh.CreateShortcut(lnk)
  sc.TargetPath = oWSH.ExpandEnvironmentStrings("%SystemRoot%") & "\System32\shutdown.exe"
  sc.Arguments = args
  sc.Description = desc
  sc.Save
  ' Start Menu shortcut
  lnk = sh.SpecialFolders("StartMenu") & "\Programs\LSL - Reboot to Select USB.lnk"
  Set sc = sh.CreateShortcut(lnk)
  sc.TargetPath = oWSH.ExpandEnvironmentStrings("%SystemRoot%") & "\System32\shutdown.exe"
  sc.Arguments = args
  sc.Description = desc
  sc.Save
  Log("Created 'LSL: Reboot to Select USB' on the Desktop and Start Menu.")
  rc = MsgBox("Install complete. Reboot now to select the USB in the boot menu?" & vbCrLf & vbCrLf & hint, vbYesNo + vbQuestion, "Boot from USB")
  If rc = vbYes Then
    Log("Rebooting now...")
    sh.Run "shutdown " & args, 0, False
  End If
End Sub

Function OSVersion()
  Dim wmi, col, d, v, parts
  OSVersion = 0
  On Error Resume Next
  Set wmi = GetObject("winmgmts:\\.\root\cimv2")
  Set col = wmi.ExecQuery("SELECT Version FROM Win32_OperatingSystem")
  For Each d In col
    v = d.Version
    parts = Split(v, ".")
    If UBound(parts) >= 1 Then
      If IsNumeric(parts(0)) And IsNumeric(parts(1)) Then OSVersion = CDbl(parts(0) & "." & parts(1))
    End If
  Next
  On Error GoTo 0
End Function
</script>
<script language="JScript">
// Sortable hardware table. Clicking a <th> reorders <tbody> rows on that column.
/* exported sortTable */ // called from the <th onclick> handlers in the HTML
var _hwSortCol = -1, _hwSortDir = 1;
function sortTable(col) {
  var tbody = document.getElementById("devBody");
  if (!tbody) return;
  var rows = [];
  for (var i = 0; i < tbody.rows.length; i++) rows.push(tbody.rows[i]);
  if (_hwSortCol === col) { _hwSortDir = -_hwSortDir; }
  else { _hwSortCol = col; _hwSortDir = 1; }
  rows.sort(function (a, b) {
    var ac = a.cells[col], bc = b.cells[col];
    var av = (ac && ac.getAttribute("data-sort") != null) ? ac.getAttribute("data-sort") : (ac ? ac.innerText : "");
    var bv = (bc && bc.getAttribute("data-sort") != null) ? bc.getAttribute("data-sort") : (bc ? bc.innerText : "");
    av = (av == null) ? "" : String(av);
    bv = (bv == null) ? "" : String(bv);
    var c = (av < bv) ? -1 : (av > bv) ? 1 : 0;
    return c * _hwSortDir;
  });
  for (var j = 0; j < rows.length; j++) tbody.appendChild(rows[j]);
  var ths = document.getElementById("devTable").tHead.rows[0].cells;
  for (var k = 0; k < ths.length; k++) {
    ths[k].className = (k === col) ? (_hwSortDir === 1 ? "asc" : "desc") : "";
  }
}
</script>
</body>
</html>
