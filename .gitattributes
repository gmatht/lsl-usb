# Keep Windows scripts as CRLF on checkout but store normalised (LF) in git
# so diffs stay minimal. cmd/.bat require CRLF line endings to run on Windows.
*.bat text eol=crlf
*.ps1 text eol=crlf
*.hta text eol=crlf
*.sh text eol=lf
# Guest-executed files: /bin/bash chokes on CRLF from Windows checkouts.
*.service text eol=lf
*.desktop text eol=lf
*.list text eol=lf
*.conf text eol=lf
