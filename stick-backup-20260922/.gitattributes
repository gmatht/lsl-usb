# Guest-executed trees: everything under bin/, misc/, systemd/, initramfs/
# (plus onboot.sh) runs under /bin/bash or systemd on the live stick, where
# CRLF from Windows checkouts is fatal. These dir rules come FIRST so the
# two Windows-side files in bin/ keep CRLF via the later overrides below
# (in .gitattributes the LAST matching line wins).
bin/** text eol=lf
misc/** text eol=lf
fuse/** text eol=lf
pi-stick/** text eol=lf
systemd/** text eol=lf
initramfs/** text eol=lf
onboot.sh text eol=lf
# Keep Windows scripts as CRLF on checkout but store normalised (LF) in git
# so diffs stay minimal. cmd/.bat require CRLF line endings to run on Windows.
*.bat text eol=crlf
*.ps1 text eol=crlf
*.hta text eol=crlf
*.sh text eol=lf
*.bats text eol=lf
*.service text eol=lf
*.desktop text eol=lf
*.list text eol=lf
*.conf text eol=lf
# The env file is *sourced by bash* on the guest (lsl-common.sh), so a CRLF
# checkout from Windows is fatal: values arrive with a trailing CR, e.g.
# LSL_DATA_DIR=/mnt/c/Users/lsl-usb\r, which matches neither /cdrom nor /persist
# and cannot be resolved by findmnt - so onboot.sh concluded the data dir was
# not persistent and fell back to a volatile tmpfs /home. Without this rule the
# file got the platform default (CRLF on Windows) because no pattern matched it.
lsl-usb.env text eol=lf
*.env text eol=lf
