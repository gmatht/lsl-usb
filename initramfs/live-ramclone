#!/bin/sh
# live-ramclone - casper-premount hook for Boot to RAM via dm-clone.
#
# When the kernel cmdline contains 'ramclone', this hook:
#   1) extracts dm-clone modules from the mounted squashfs
#   2) loads dm-clone (and brd, or falls back to tmpfs+loop)
#   3) creates a dm-clone device with the squashfs as origin and RAM as dest
#   4) overrides get_backing_device so casper mounts /dev/mapper/clone
#
# The hook is SOURCED by casper's run_scripts (via ORDER file), so exports
# and function overrides propagate into casper's shell.
set +e

grep -qw ramclone /proc/cmdline 2>/dev/null || return 0 2>/dev/null || exit 0

# Idempotent: if clone already exists, nothing to do.
[ -e /dev/mapper/clone ] && return 0 2>/dev/null || exit 0

# Skip if HDD mirror is active (already on fast local disk).
[ -n "${LAYERFS_PATH}" ] && return 0 2>/dev/null || exit 0

# Find the squashfs file on the live medium.
SQFS=""
for cand in /cdrom/casper/filesystem.squashfs \
            /cdrom/casper/filesystem.z0.squashfs; do
    [ -f "$cand" ] && { SQFS="$cand"; break; }
done
[ -n "$SQFS" ] || return 0 2>/dev/null || exit 0

BYTES=$(stat -c %s "$SQFS" 2>/dev/null || echo "")
[ -n "$BYTES" ] || return 0 2>/dev/null || exit 0
SECT=$((BYTES / 512))
[ $((BYTES % 512)) -eq 0 ] || return 0 2>/dev/null || exit 0

# Get kernel version from initramfs module paths.
KVER=""
for d in /lib/modules/*/; do
    [ -d "$d" ] && { KVER="${d%/}"; KVER="${KVER##*/}"; break; }
done
[ -n "$KVER" ] || return 0 2>/dev/null || exit 0

# Mount squashfs temporarily to copy dm-clone modules into the initramfs.
mkdir -p /mnt/sqfs
mount -t squashfs -o ro "$SQFS" /mnt/sqfs 2>/dev/null || return 0 2>/dev/null || exit 0

MOD_SRC="/mnt/sqfs/lib/modules/$KVER/kernel/drivers/md"
MOD_DST="/lib/modules/$KVER/kernel/drivers/md"
mkdir -p "$MOD_DST"

for mod in dm-persistent-data dm-clone; do
    src="$MOD_SRC/${mod}.ko.zst"
    [ -f "$src" ] && cp "$src" "$MOD_DST/"
done
umount /mnt/sqfs 2>/dev/null || true

# Update modules.dep so modprobe can find the new modules.
DEP="/lib/modules/$KVER/modules.dep"
if [ -f "$DEP" ] && ! grep -q "kernel/drivers/md/dm-clone.ko" "$DEP" 2>/dev/null; then
    echo "kernel/drivers/md/dm-clone.ko: kernel/drivers/md/dm-persistent-data.ko" >> "$DEP"
    echo "kernel/drivers/md/dm-persistent-data.ko:" >> "$DEP"
fi
# Remove binary index so modprobe falls back to the text dep file.
rm -f "/lib/modules/$KVER/modules.dep.bin" 2>/dev/null || true

# Load dm-clone.
modprobe dm_clone 2>/dev/null || return 0 2>/dev/null || exit 0

# Create RAM destination device.
DEST_DEV=""
if modprobe brd rd_nr=1 rd_size=$((BYTES / 1024)) 2>/dev/null; then
    DEST_DEV="/dev/ram0"
else
    # Fallback: sparse file on tmpfs + loop device.
    mkdir -p /run/ramclone
    dd if=/dev/zero of=/run/ramclone/dest bs=1M count=$((BYTES / 1024 / 1024 + 1)) 2>/dev/null
    DEST_DEV=$(losetup -f --show /run/ramclone/dest 2>/dev/null)
fi
[ -b "$DEST_DEV" ] || return 0 2>/dev/null || exit 0

# Metadata bitmap device (tmpfs file + loop).
META_BYTES=$((8 * 1024 * 1024))
mkdir -p /run/ramclone
dd if=/dev/zero of=/run/ramclone/meta bs=1M count=8 2>/dev/null
META_DEV=$(losetup -f --show /run/ramclone/meta 2>/dev/null)
[ -b "$META_DEV" ] || { losetup -d "$DEST_DEV" 2>/dev/null; return 0 2>/dev/null || exit 0; }

# Origin: read-only loop over the squashfs file.
ORIGIN_DEV=$(losetup -f --show --read-only "$SQFS" 2>/dev/null)
[ -b "$ORIGIN_DEV" ] || {
    losetup -d "$META_DEV" 2>/dev/null
    losetup -d "$DEST_DEV" 2>/dev/null
    return 0 2>/dev/null || exit 0
}

# Create dm-clone device.
dmsetup create clone --table "0 $SECT clone $META_DEV $DEST_DEV $ORIGIN_DEV" 2>/dev/null || {
    losetup -d "$ORIGIN_DEV" 2>/dev/null
    losetup -d "$META_DEV" 2>/dev/null
    losetup -d "$DEST_DEV" 2>/dev/null
    return 0 2>/dev/null || exit 0
}

# Record state for runtime scripts.
mkdir -p /run/ramclone
echo "$SQFS"   > /run/ramclone/sqfs
echo "$ORIGIN_DEV" > /run/ramclone/origin_loop
echo "$META_DEV"  > /run/ramclone/meta_loop
echo "$DEST_DEV" > /run/ramclone/dest_dev
echo "active"  > /run/ramclone/status
touch /run/ramclone/ready

# Override get_backing_device so casper mounts the clone device instead
# of setting up a loop over the squashfs file.
get_backing_device() {
    case "$1" in
        */filesystem.squashfs|*/filesystem.z0.squashfs)
            echo "/dev/mapper/clone"
            return 0
            ;;
        *.squashfs|*.ext2)
            dev="$(/sbin/losetup -f --show --read-only "$1" 2>/dev/null)"
            if [ -n "$dev" ]; then
                echo "$dev"
                return 0
            fi
            echo "No loop devices available" >&2
            return 1
            ;;
        *.dir)
            echo "directory"
            return 0
            ;;
        *)
            echo "Unrecognized casper filesystem: $1" >&2
            return 1
            ;;
    esac
}

# Log to console.
{
    echo "ramclone: dm-clone active"
    echo "ramclone: sqfs=$SQFS origin=$ORIGIN_DEV dest=$DEST_DEV"
    echo "ramclone: hydration running in background"
} > /dev/console 2>/dev/null

return 0 2>/dev/null || exit 0
