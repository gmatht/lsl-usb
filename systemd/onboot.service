[Unit]
Description=On Boot
After=NetworkManager.service
Before=network-online.target
# /home is mounted by lsl-home.service, which the greeter itself waits on
# (Before=display-manager.service); run after it so the home-dependent steps
# here (flatpak view, cache/log binds, autostart entries) see the real /home.
After=lsl-home.service

[Service]
Type=oneshot
RemainAfterExit=yes
# onboot.sh backgrounds the nix-users retry loop and the wifi wait; keep them
# alive after the main script exits instead of killing the whole cgroup (the
# default KillMode).
KillMode=process
ExecStart=/cdrom/onboot.sh

[Install]
WantedBy=multi-user.target
