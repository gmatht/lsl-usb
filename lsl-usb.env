# LSL-USB data directory (edit on the USB FAT partition; no squashfs rebuild needed).
# Default: Windows user folder on NTFS (HDD mode — direct btrfs, no idle squashfs batching).
LSL_DATA_DIR=/mnt/c/Users/lsl-usb

# USB mode is detected automatically: path resolves under /cdrom or /persist.
# HDD mode: any other path (typical: /mnt/c/...).

# Idle seconds before flushing /home overlay to home.sfs on USB (linear mksquashfs write).
LSL_HOME_IDLE_SEC=300

# Initial sparse image sizes (Mebibytes) when creating home.btrfs / cache.btrfs on HDD.
# cache.btrfs holds /var/cache, ~/.cache, and most of Nix (/nix/store, /nix/var); increase if you use Nix heavily.
LSL_HOME_BTRFS_MIB=4096
LSL_CACHE_BTRFS_MIB=2048

# tmpfs size for USB-mode /home overlay upper+work (Mebibytes).
LSL_HOME_TMPFS_MIB=2048

# zram swap size (Mebibytes). Empty = 80% of RAM (min 128). Set to 0 to disable.
# LSL_ZRAM_MIB=

# Auto-run safe_ntfsfix.sh on the most-recently-booted Windows partition at
# boot (mount_all.sh). Off by default: the repair script is not yet
# battle-tested. Set to 1 to enable.
# LSL_NTFSFIX=0

# Grow home.btrfs on HDD when free space falls below this percent (or chunk grow size).
LSL_BTRFS_MIN_FREE_PCT=10
LSL_BTRFS_GROW_CHUNK_MIB=1024

# --- Windows-folder backups to squashfs (bin/lsl-win-backup.sh) ---
# Daily incremental + full backups of selected Windows folders, stored as squashfs
# under LSL_BACKUP_DIR. Add jobs to <LSL_BACKUP_DIR>/backup.conf (or run
# lsl-win-backup.sh --add-folder). A systemd timer (lsl-win-backup.timer) runs
# them daily once enabled (config.sh enables it; it is a no-op until jobs exist).
# LSL_BACKUP_DIR            default: <LSL_DATA_DIR>/backups
# LSL_BACKUP_WINDOW_HOURS   default: 24.1  (first-run / --full window; >24h so cron jitter never skips a file)
# LSL_BACKUP_INCR_SLACK_SEC default: 600   (overlap past the previous run's timestamp)
# LSL_BACKUP_KEEP           default: 7     (squashfs retained per job)
# LSL_BACKUP_EST_FACTOR     default: 0.6   (fallback compress ratio for --estimate)

# --- Copy squashfs layers to the NTFS HDD for speed (bin/lsl-copy-sfs-hdd.sh) ---
# When 1, lsl-precache.sh warms the page cache from the HDD copy of the layers
# (copied by the installer wizard or lsl-copy-sfs-hdd.sh) instead of the USB.
# The installer wizard sets this when you accept the "copy layers to HDD" offer.
# LSL_SFS_HDD_CACHE=0
